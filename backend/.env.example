PORT=5000
MONGODB_URI=mongodb://localhost:27017/blog-ai
JWT_SECRET=votre_secret_jwt_super_securise_a_changer
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# AI Configuration
# Options: openai, anthropic, demo
# - openai: Utilise GPT-4o (nécessite OPENAI_API_KEY)
# - anthropic: Utilise Claude 3.5 Sonnet (nécessite ANTHROPIC_API_KEY)
# - demo: Mode démo sans API (contenu générique)
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
